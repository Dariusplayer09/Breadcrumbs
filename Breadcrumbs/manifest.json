{
    "manifest_version": 3,
    "name" : "Breadcrumbs",
    "version": "1.0",
    "description": "How did you end up in this rabbit hole?",
    "permissions": ["tabs", "storage", "webNavigation"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "logo16.png",
        "48": "logo48.png",
        "128": "logo128.png"
    },

    "content_scripts": [
  {
    "matches": ["*://*.wikipedia.org/*"],
    "js": ["content-wikipedia.js"]
  },
  {
    "matches": ["*://*.youtube.com/*"],
    "css": ["content-youtube.css"]
  }]
}
